# ---- Copy this file to ".env" (or run: python scripts/set_keys.py). Never commit .env to GitHub. ----

# Meta Model API key (dev.meta.ai -> API keys). Leave empty to run in free DEMO mode.
MODEL_API_KEY=
# META_API_BASE=https://api.meta.ai/v1

# 1 = force demo mode (recorded answers, no API spend) even when a key is set
MOCK=0

# Optional open weights: diagnosis + plan on Muse Spark Open via Baseten
USE_OPEN_WEIGHTS=0
BASETEN_API_KEY=
# OPEN_MODEL=meta-models/muse-spark-open

# Muse Image diagrams for steps the photo can't show (about $0.01 each)
ILLUSTRATE=1
MAX_DIAGRAMS=2
# Muse Spark reviews each diagram and redraws a bad one once
DIAGRAM_CHECKER=1
# Server voice files for each step (free Edge voices). 0 = the phone's own voice
NARRATION_VOICE=1
# Stop a single repair if it would cost more than this (USD)
MAX_COST_PER_SESSION_USD=0.50
# Public deployment guard (live mode only): new repairs per visitor per hour, and a rolling 24 h spend cap in USD. 0 = off.
RATE_LIMIT_PER_HOUR=30
DAILY_BUDGET_USD=10
# Failed "check my step" photos before suggesting a re-plan or a professional
MAX_CHECK_FAILS=2
# Photos and sessions are deleted after this many hours
RETENTION_HOURS=24

# Live camera guide: SAM 3.1 on live camera frames. Max frames per repair (~$0.0025 each) and min seconds between frames
MAX_TRACK_FRAMES=120
TRACK_MIN_INTERVAL_S=0.6
# 1 = if a live model call still fails after retries, use the labelled demo answer for that stage (repair keeps going).
# Set 0 while testing a new key so errors show instead (deploy_check.py also flags sessions that used it)
DEMO_FALLBACK=1
# Optional secret: allows downloading the trial outcome log (GET /api/impact/outcomes.jsonl, header X-Impact-Token)
IMPACT_TOKEN=

# Public https address for share and mechanic hand-off links (your Render URL, e.g. https://tukang-copilot.onrender.com)
PUBLIC_BASE_URL=
